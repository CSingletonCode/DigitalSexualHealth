<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane prefWidth="335" prefHeight="600" style="-fx-background-color: rgba(50, 50, 50, 0.3);" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.AppointmentConfirmationController">
   <children>
      <VBox spacing="15" alignment="TOP_CENTER" maxWidth="300" maxHeight="500" minWidth="300" minHeight="500" styleClass="confirmation-card" stylesheets="@style.css">
         <padding>
            <Insets top="20" right="15" bottom="20" left="15"/>
         </padding>
         <children>
            <Label text="Confirm Your Booking" styleClass="header-text-small"/>

            <GridPane vgap="12" hgap="10" VBox.vgrow="ALWAYS">
               <columnConstraints>
                  <ColumnConstraints minWidth="70" prefWidth="70" maxWidth="70" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="180" prefWidth="180" />
               </columnConstraints>

               <children>
                  <Label text="Name:" styleClass="detail-header" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                  <Label fx:id="nameLabel" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                  <Label text="Age:" styleClass="detail-header" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                  <Label fx:id="ageLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                  <Label text="Gender:" styleClass="detail-header" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                  <Label fx:id="genderLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                  <Label text="Clinic:" styleClass="detail-header" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.valignment="TOP"/>
                  <Label fx:id="clinicDetails" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                  <Label text="Date:" styleClass="detail-header" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                  <Label fx:id="dateLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                  <Label text="Time:" styleClass="detail-header" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                  <Label fx:id="timeLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                  <Label text="Purpose:" styleClass="detail-header" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.valignment="TOP"/>
                  <Label fx:id="purposeLabel" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
               </children>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
               <Button fx:id="backButton" text="Back" styleClass="btn-red-fixed"/>
               <Button fx:id="confirmButton" text="Confirm" styleClass="btn-green-fixed"/>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>