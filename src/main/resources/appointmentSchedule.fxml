<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="640.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.AppointmentSchedulePage">
    <children>
        <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" spacing="20.0" styleClass="root">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="returnButton" mnemonicParsing="false" text="←" />
                        <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="helpButton" styleClass="help-button" text="Need Help?" StackPane.alignment="TOP_RIGHT" />
                    </children>
                </HBox>
                <Label alignment="CENTER" maxWidth="Infinity" minHeight="-Infinity" prefHeight="68.0" prefWidth="303.0" styleClass="header-label" text="Appointment Schedule" wrapText="true" />
                <HBox fx:id="bookButtonContainer" alignment="CENTER">
                    <children>
                        <Button fx:id="bookAppointmentButton" mnemonicParsing="false" styleClass="submit-button" text="Book an Appointment" />
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" styleClass="edge-to-edge-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="appointmentListContainer" spacing="15.0">
                            <children>
                                <VBox alignment="CENTER_LEFT" maxWidth="317.0" prefHeight="142.0" prefWidth="317.0" spacing="8.0" styleClass="schedule-card" VBox.vgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label fx:id="appointmentDate" styleClass="card-date-header" text="2025-12-16" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="appointmentStatus" styleClass="status-badge, upcoming" text="UPCOMING" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="clinicName" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" prefHeight="0.0" prefWidth="249.0" styleClass="card-detail-text" text="Name: Clinic 1" wrapText="true" VBox.vgrow="ALWAYS" />
                                        <Label fx:id="appointmentTime" alignment="TOP_LEFT" styleClass="card-detail-text" text="Time: 14:00" />
                                        <Label fx:id="clinicAddress" alignment="TOP_LEFT" maxWidth="279.0" styleClass="card-detail-text" text="Address: 38, Burgess Road, SO16 5NE, Southampton" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets bottom="15" left="15" right="15" top="15" />
                                    </padding>
                                </VBox>
                            </children>
                            <padding>
                                <Insets bottom="10" left="2" right="10" top="5" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
            <padding>
                <Insets bottom="10" left="20" right="20" top="15" />
            </padding>
        </VBox>
        <Pane fx:id="dimLayer" mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" />
        <VBox fx:id="tutorialOverlay" alignment="CENTER" spacing="20" visible="false">
           <children>
               <VBox alignment="CENTER" spacing="15" styleClass="tutorial-card">
                  <children>
                      <Label fx:id="tutorialText" styleClass="tutorial-text" text="Tutorial text" wrapText="true" />
                      <HBox alignment="CENTER" spacing="10">
                         <children>
                             <Button fx:id="tutorialNextButton" styleClass="tutorial-btn-next" text="Next" />
                             <Button fx:id="tutorialSkipButton" styleClass="tutorial-btn-skip" text="Skip" />
                         </children>
                      </HBox>
                  </children>
               </VBox>
           </children>
        </VBox>
        <Button fx:id="fakeBookButton" mouseTransparent="true" styleClass="submit-button, tutorial-focus-highlight" text="Book an Appointment" visible="false" StackPane.alignment="TOP_LEFT" />
    </children>
</StackPane>
