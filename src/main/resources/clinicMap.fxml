<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.ClinicMap">
    <children>
        <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" spacing="10.0" styleClass="root" stylesheets="@style.css">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="returnButton" mnemonicParsing="false" text="←" />
                  <Region prefHeight="50.0" prefWidth="142.0" />
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveAndExit" styleClass="button-small" text="Save &amp; Exit" />
                    </children>
                </HBox>

                <HBox alignment="CENTER" />
                <WebView fx:id="webView" prefHeight="439.0" prefWidth="295.0" />
            </children>
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
            </padding>
        </VBox>
        <Button fx:id="fakeBookButton" mouseTransparent="true" styleClass="button-small, tutorial-focus-highlight" text="Book" visible="false" StackPane.alignment="TOP_LEFT" />
        <Button fx:id="fakeInfoButton" mouseTransparent="true" styleClass="button-small, tutorial-focus-highlight" text="More Info" visible="false" StackPane.alignment="TOP_LEFT" />
    </children>
</StackPane>
