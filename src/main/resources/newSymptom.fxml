<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="232.0" prefWidth="335.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.PopupController">
   <children>
      <TextField fx:id="nameField" layoutX="17.0" layoutY="14.0" onMouseClicked="#showDropDown" prefHeight="25.0" prefWidth="228.0" promptText="Click to show registered, or enter own" styleClass="fancy-text-field" />

      <TextField fx:id="descriptionField" alignment="TOP_LEFT" layoutX="17.0" layoutY="91.0" prefHeight="95.0" prefWidth="299.0" promptText="Enter Description" styleClass="fancy-text-field" />

      <Button fx:id="enterButton" layoutX="17.0" layoutY="193.0" mnemonicParsing="false" onAction="#submit" prefHeight="25.0" prefWidth="84.0" styleClass="submit-button" text="Enter" textAlignment="CENTER" />

      <Button fx:id="cancelButton" layoutX="260.0" layoutY="15.0" mnemonicParsing="false" onAction="#cancel" styleClass="button-small" text="Cancel" />

      <ScrollPane fx:id="optionsScroll" hbarPolicy="NEVER" layoutX="24.0" layoutY="38.0" prefHeight="95.0" prefWidth="216.0" styleClass="edge-to-edge-scroll" visible="false">
         <content>
            <VBox fx:id="optionsBox" prefHeight="94.0" prefWidth="214.0" spacing="2.0" visible="false" />
         </content>
      </ScrollPane>
      <DatePicker fx:id="dateField" layoutX="17.0" layoutY="47.0" prefHeight="36.0" prefWidth="196.0" promptText="DD-MM-YYYY" styleClass="date-picker" />
   </children>
</Pane>
