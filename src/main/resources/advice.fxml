<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.*?>


<VBox fx:id="mainContainer" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" spacing="10.0" styleClass="root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.myapp.AdviceController">
    <padding>
        <Insets left="10.0" right="10.0" top="10.0"  />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button fx:id="returnButton" minWidth="-Infinity" onAction="#handleBackToHome" prefHeight="26.0" prefWidth="75.0" styleClass="eval-home-button" text="←" />
        <Label styleClass="header-text" text="Advice"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10" >
        <ToggleButton fx:id="allFilter" onAction="#handleFilter" selected="true" styleClass="button-small-eval" text="All">
            <toggleGroup><ToggleGroup fx:id="filterGroup" /></toggleGroup>
        </ToggleButton>
        <ToggleButton onAction="#handleFilter" styleClass="button-small-eval" text="LGBTQ+" toggleGroup="$filterGroup" />
        <ToggleButton onAction="#handleFilter" styleClass="button-small-eval" text="Youth" toggleGroup="$filterGroup" />
    </HBox>

    <Label styleClass="text-silent" text="Select a category to filter resources" />
    <ScrollPane fitToWidth="true" styleClass="edge-to-edge-scroll" VBox.vgrow="ALWAYS" >
        <VBox fx:id="adviceListContainer" spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="5.0" right="5.0" top="10.0" />
            </padding>
        </VBox>
    </ScrollPane>

</VBox>
