<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.NotificationsController">
    <center>
        <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>

                <VBox prefHeight="640.0" prefWidth="360.0" spacing="15" styleClass="main-container">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>

                    <!-- header -->
                    <HBox alignment="CENTER_LEFT" prefHeight="54.0" prefWidth="330.0">
                        <Button fx:id="returnButton" mnemonicParsing="false" prefHeight="26.0" prefWidth="68.0" text="←" />
                        <Region prefHeight="54.0" prefWidth="21.0" HBox.hgrow="ALWAYS" />

                        <Label prefHeight="54.0" prefWidth="206.0" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: black;" text="Notifications" wrapText="true" />
                  <Region prefHeight="54.0" prefWidth="38.0" />
                    </HBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="506.0" prefWidth="326.0" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">

                        <content>
                            <VBox fx:id="notificationsContainer" fillWidth="true" prefWidth="328.0" spacing="12">
                                <padding>
                                    <Insets bottom="10" left="2" right="2" top="10" />
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>

                </VBox>

            </children>
        </AnchorPane>
    </center>
</BorderPane>
