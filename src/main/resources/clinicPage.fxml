<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.ClinicController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="335.0" spacing="10.0" styleClass="root" stylesheets="@style.css">
          <children>
              <HBox alignment="CENTER_LEFT">
                  <children>
                      <Button fx:id="returnButton" mnemonicParsing="false" text="←" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="helpButton" styleClass="icon-purple" text="Need Help?" StackPane.alignment="TOP_RIGHT" />
                  </children>
              </HBox>
              <Label prefHeight="34.0" prefWidth="204.0" styleClass="header-label" text="Clinics Nearby " wrapText="true" />
            <HBox alignment="CENTER_LEFT" prefHeight="46.0" prefWidth="295.0">
               <children>
                  <Label styleClass="clinic-name" text="Filter: " />
                  <ComboBox fx:id="costFilter" prefHeight="35.0" prefWidth="132.0">
                       <items>
                           <FXCollections fx:factory="observableArrayList">
                               <String fx:value="All" />
                               <String fx:value="Free" />
                               <String fx:value="Charged" />
                           </FXCollections>
                       </items>
                    </ComboBox>
                   <Region prefHeight="46.0" prefWidth="9.0" />
                   <Button fx:id="showMap" mnemonicParsing="false" styleClass="button-small" text="Show On Map" />
               </children>
            </HBox>
      
              <HBox alignment="CENTER" />
      
              <ScrollPane fitToWidth="true" styleClass="edge-to-edge-scroll" VBox.vgrow="ALWAYS">
                  <content>
                      <VBox fx:id="clinicListContainer" spacing="15.0">
                          <children>
                              <VBox spacing="8.0" styleClass="schedule-card">
                                  <children>
                                        <Label fx:id="clinicName" maxWidth="255.0" styleClass="card-date-header" text="Clinic 1" wrapText="true" HBox.hgrow="SOMETIMES" />
                                      <Label fx:id="clinicAddress" styleClass="card-detail-text" text="Address: 38, Burgess Road, SO16 5NE, Southampton" wrapText="true" />
                              <HBox alignment="CENTER_RIGHT" prefHeight="38.0" prefWidth="251.0" spacing="10.0">
                                 <children>
                                    <Label fx:id="clinicDistance" alignment="CENTER_RIGHT" minWidth="60.0" text="0.8 miles away" wrapText="true" />
                                    <Button mnemonicParsing="false" styleClass="button-small" text="Book" />
                                    <Button mnemonicParsing="false" style="-fx-background-color: #5e6b70;" styleClass="button-small" text="More Info" />
                                 </children>
                              </HBox>
                                  </children>
                                  <padding>
                                      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                  </padding>
                              </VBox>
                          </children>
                          <padding>
                              <Insets bottom="10.0" left="2.0" right="10.0" top="5.0" />
                          </padding>
                      </VBox>
                  </content>
              </ScrollPane>
          </children>
          <padding>
              <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
          </padding>
      </VBox>
       <VBox fx:id="tutorialOverlay" alignment="CENTER" spacing="20" style="-fx-background-color: rgba(0,0,0,0.6); -fx-padding: 150 0 0 0;" visible="false">
          <children>
              <VBox alignment="CENTER" spacing="15" styleClass="tutorial-card">
                 <children>
                     <Label fx:id="tutorialText" styleClass="tutorial-text" wrapText="true" />
      
                     <HBox alignment="CENTER" spacing="10">
         <children>
                            <Button fx:id="tutorialNextButton" styleClass="tutorial-btn-next" text="Next" />
                            <Button fx:id="tutorialSkipButton" styleClass="tutorial-btn-skip" text="Skip" />
         </children>
                     </HBox>
                 </children>
   
              </VBox>
          </children>
       </VBox>
       <Button fx:id="fakeBookButton" mouseTransparent="true" styleClass="button-small, tutorial-focus-highlight" text="Book" visible="false" StackPane.alignment="TOP_LEFT" />
       <Button fx:id="fakeInfoButton" mouseTransparent="true" styleClass="button-small, tutorial-focus-highlight" text="More Info" visible="false" StackPane.alignment="TOP_LEFT" />
   </children>
</StackPane>
