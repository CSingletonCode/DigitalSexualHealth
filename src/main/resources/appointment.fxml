<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="335.0" spacing="18.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.myapp.AppointmentPage">
   <children>
      <Button fx:id="returnButton" mnemonicParsing="false" text="←" />

      <Label styleClass="header-label" text="Book an Appointment" />

      <VBox spacing="0.0" style="-fx-background-color: transparent;">
         <children>
            <VBox prefHeight="102.0" prefWidth="295.0" spacing="5.0" styleClass="clinic-card-primary">
               <children>
                  <Label fx:id="currentClinic" prefHeight="18.0" prefWidth="265.0" styleClass="clinic-name" text="Current Clinic" wrapText="true" />
                  <Label fx:id="currentClinicAddress" alignment="TOP_LEFT" prefHeight="54.0" prefWidth="265.0" styleClass="clinic-address" text="Clinic Address" wrapText="true" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
            </VBox>
         </children>
      </VBox>

      <VBox spacing="8.0">
         <children>
            <Label styleClass="field-label" text="Appointment Date" />
            <DatePicker fx:id="appointmentDatePicker" maxWidth="1.7976931348623157E308" prefHeight="45.0" promptText="YYYY/MM/DD" />
         </children>
      </VBox>

      <VBox spacing="8.0">
         <children>
            <Label styleClass="field-label" text="Appointment Time" />
            <ComboBox fx:id="appointmentTimeBox" maxWidth="1.7976931348623157E308" prefHeight="45.0" promptText="Select a time" />
         </children>
      </VBox>

      <VBox spacing="8.0">
         <children>
            <Label styleClass="field-label" text="Appointment Purpose" />
            <TextArea fx:id="appointmentPurposeText" prefHeight="120.0" promptText="Describe the reason..." wrapText="true" />
         </children>
      </VBox>

      <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="appointmentSubmitButton" maxWidth="1.7976931348623157E308" minHeight="50.0" text="Submit" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
   </padding>
</VBox>
