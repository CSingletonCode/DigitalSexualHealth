<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" spacing="10.0" styleClass="root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="com.myapp.EvaluationController">
    <padding>
        <Insets left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="returnButton" minWidth="-Infinity" onAction="#handleBackToHome" prefHeight="26.0" prefWidth="75.0" styleClass="eval-home-button" text="←" />
        <Label alignment="CENTER" prefHeight="38.0" prefWidth="182.0" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: black;" text="Evaluation" textAlignment="CENTER" />
        <Region maxWidth="-Infinity" minWidth="-Infinity" prefHeight="38.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
        <Button fx:id="allergiesButton" alignment="CENTER" minWidth="91.0" onAction="#handleGoToAllergies" prefHeight="38.0" prefWidth="91.0" styleClass="allergy-button" text="Allergies" textAlignment="CENTER" />
    </HBox>

    <VBox prefHeight="366.0" prefWidth="339.0" spacing="10.0" VBox.vgrow="ALWAYS">
        <VBox alignment="CENTER" spacing="15" styleClass="evaluation-card">
            <Label fx:id="q1Label" minHeight="-Infinity" prefWidth="320" styleClass="evaluation-sub-header" text="Loading question..." textAlignment="CENTER" wrapText="true" />
            <HBox alignment="CENTER" spacing="10">
                  <ToggleButton fx:id="q1Yes" styleClass="button-small-eval" text="Yes">
                      <toggleGroup><ToggleGroup fx:id="group1" /></toggleGroup>
                  </ToggleButton>
                  <ToggleButton fx:id="q1Maybe" styleClass="button-small-eval" text="Not Sure" toggleGroup="$group1" />
                  <ToggleButton fx:id="q1No" styleClass="button-small-eval" text="No" toggleGroup="$group1" />
            </HBox>
        </VBox>

        <VBox alignment="CENTER" spacing="10" styleClass="evaluation-card">
            <Label fx:id="q2Label" minHeight="-Infinity" prefWidth="320" styleClass="evaluation-sub-header" text="Loading question..." textAlignment="CENTER" wrapText="true" />
            <HBox alignment="CENTER" spacing="10">
                <ToggleButton fx:id="q2Yes" styleClass="button-small-eval" text="Yes">
                    <toggleGroup><ToggleGroup fx:id="group2" /></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="q2Maybe" styleClass="button-small-eval" text="Not Sure" toggleGroup="$group2" />
                <ToggleButton fx:id="q2No" styleClass="button-small-eval" text="No" toggleGroup="$group2" />
            </HBox>
        </VBox>

        <VBox alignment="CENTER" spacing="10" styleClass="evaluation-card">
            <Label fx:id="q3Label" minHeight="-Infinity" prefWidth="320" styleClass="evaluation-sub-header" text="Loading question..." textAlignment="CENTER" wrapText="true" />
            <HBox alignment="CENTER" spacing="10">
                <ToggleButton fx:id="q3Yes" styleClass="button-small-eval" text="Yes">
                    <toggleGroup><ToggleGroup fx:id="group3" /></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="q3Maybe" styleClass="button-small-eval" text="Not Sure" toggleGroup="$group3" />
                <ToggleButton fx:id="q3No" styleClass="button-small-eval" text="No" toggleGroup="$group3" />
            </HBox>
        </VBox>
    </VBox>

    <HBox alignment="CENTER" prefHeight="87.0" prefWidth="320.0" spacing="20.0">

        <VBox alignment="CENTER" spacing="5">
            <Button onAction="#handlePrevPage" styleClass="icon-button" text="&lt;" />
            <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Go back" />
        </VBox>
        <Label fx:id="pageIndicatorLabel" style="-fx-text-fill: #888888; -fx-font-weight: bold;" styleClass="eval-low-label" text="Page 1 / 4" />

        <VBox alignment="CENTER" spacing="5">
            <Button fx:id="nextButton" minHeight="65" minWidth="65" onAction="#handleNextPage" prefHeight="65" prefWidth="65" styleClass="icon-button" text="&gt;" />
            <Label fx:id="nextLabel" style="-fx-font-weight: bold; -fx-font-size: 14;" text="Next" />
        </VBox>
    </HBox>
</VBox>
