<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="mainContainer" spacing="35" alignment="TOP_CENTER" prefWidth="400" prefHeight="700"
      styleClass="root" xmlns:fx="https://javafx.com/fxml/1" fx:controller="com.myapp.EvaluationController">
    <padding>
        <Insets top="40" right="20" bottom="20" left="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button fx:id="returnButton" text="←" onAction="#handleBackToHome"
                styleClass="-fx-background-color: transparent; -fx-text-fill: #7158B7; -fx-font-size: 24px; -fx-font-weight: bold; "/>
        <Label text="Evaluation" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: black;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Allergies" onAction="#handleGoToAllergies"
                styleClass="button-small-eval"
                style="-fx-font-size: 16px; -fx-font-weight: bold; --fx-min-width:100px;"/>
    </HBox>

    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox styleClass="evaluation-card" spacing="15" alignment="CENTER">
            <Label fx:id="q1Label" text="Loading question..." wrapText="true" textAlignment="CENTER" prefWidth="320" minHeight="-Infinity" styleClass="evaluation-sub-header"/>
            <HBox spacing="10" alignment="CENTER">
                  <ToggleButton text="Yes" fx:id="q1Yes" styleClass="button-small-eval">
                      <toggleGroup><ToggleGroup fx:id="group1"/></toggleGroup>
                  </ToggleButton>
                  <ToggleButton text="Not Sure" fx:id="q1Maybe" styleClass="button-small-eval" toggleGroup="$group1"/>
                  <ToggleButton text="No" fx:id="q1No" styleClass="button-small-eval" toggleGroup="$group1"/>
            </HBox>
        </VBox>

        <VBox styleClass="evaluation-card" spacing="10" alignment="CENTER">
            <Label fx:id="q2Label" text="Loading question..." wrapText="true" textAlignment="CENTER" prefWidth="320" minHeight="-Infinity" styleClass="evaluation-sub-header"/>
            <HBox spacing="10" alignment="CENTER">
                <ToggleButton text="Yes" fx:id="q2Yes" styleClass="button-small-eval">
                    <toggleGroup><ToggleGroup fx:id="group2"/></toggleGroup>
                </ToggleButton>
                <ToggleButton text="Not Sure" fx:id="q2Maybe" styleClass="button-small-eval" toggleGroup="$group2"/>
                <ToggleButton text="No" fx:id="q2No" styleClass="button-small-eval" toggleGroup="$group2"/>
            </HBox>
        </VBox>

        <VBox styleClass="evaluation-card" spacing="10" alignment="CENTER">
            <Label fx:id="q3Label" text="Loading question..." wrapText="true" textAlignment="CENTER" prefWidth="320" minHeight="-Infinity" styleClass="evaluation-sub-header"/>
            <HBox spacing="10" alignment="CENTER">
                <ToggleButton text="Yes" fx:id="q3Yes" styleClass="button-small-eval">
                    <toggleGroup><ToggleGroup fx:id="group3"/></toggleGroup>
                </ToggleButton>
                <ToggleButton text="Not Sure" fx:id="q3Maybe" styleClass="button-small-eval" toggleGroup="$group3"/>
                <ToggleButton text="No" fx:id="q3No" styleClass="button-small-eval" toggleGroup="$group3"/>
            </HBox>
        </VBox>
    </VBox>

    <HBox alignment="CENTER" spacing="100">
        <padding>
            <Insets bottom="30" />
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Button onAction="#handlePrevPage" styleClass="icon-button">
                <text>&lt;</text></Button>
            <Label text="Go back" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="5">
            <Button fx:id="nextButton" onAction="#handleNextPage" styleClass="icon-button"
                    minWidth="65" minHeight="65" prefWidth="65" prefHeight="65">
                <text>&gt;</text>
            </Button>
            <Label fx:id="nextLabel" text="Next" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        </VBox>
    </HBox>
    <HBox alignment="CENTER">
        <padding>
            <Insets bottom="10" />
        </padding>
        <Label fx:id="pageIndicatorLabel" text="Page 1 / 4"
               style="-fx-font-size: 14px; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
    </HBox>
</VBox>



