<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@clinics.css"
            prefWidth="390.0" prefHeight="844.0">

    <VBox spacing="16" fillWidth="true" styleClass="screen"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <!-- screen padding -->
        <padding>
            <Insets top="22" right="22" bottom="22" left="22"/>
        </padding>

        <!-- Top bar -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="topbar">
            <Button text="←" styleClass="back-button" focusTraversable="false"/>
        </HBox>

        <!-- Title -->
        <Label text="Clinics Nearby" styleClass="title"/>

        <!-- List -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="list-scroll">
            <content>
                <VBox spacing="16" fillWidth="true">
                    <padding>
                        <Insets top="0" right="0" bottom="24" left="0"/>
                    </padding>

                    <!-- Card 1 -->
                    <StackPane styleClass="clinic-card">
                        <VBox spacing="10" fillWidth="true">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Clinic 1" styleClass="card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="0.8 miles away" styleClass="distance"/>
                            </HBox>

                            <Label text="Address: 38, Burgess Road, SO16 5NE, Southampton"
                                   wrapText="true" styleClass="card-body"/>
                            <Label text="Working Hours: Daily 8am - 6pm"
                                   wrapText="true" styleClass="card-body"/>

                            <HBox alignment="CENTER_RIGHT">
                                <Button text="Contact  ›" styleClass="contact-button"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- Card 2 -->
                    <StackPane styleClass="clinic-card">
                        <VBox spacing="10" fillWidth="true">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Clinic 2" styleClass="card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="1.6 miles away" styleClass="distance"/>
                            </HBox>

                            <Label text="Address: 56, Highfield Street, SO14 2NU, Southampton"
                                   wrapText="true" styleClass="card-body"/>
                            <Label text="Working Hours: 24 Hours"
                                   wrapText="true" styleClass="card-body"/>

                            <HBox alignment="CENTER_RIGHT">
                                <Button text="Contact  ›" styleClass="contact-button"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- Card 3 -->
                    <StackPane styleClass="clinic-card">
                        <VBox spacing="10" fillWidth="true">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Clinic 3" styleClass="card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="1.7 miles away" styleClass="distance"/>
                            </HBox>

                            <Label text="97, Westwood Road, SO17 6XT, Southampton"
                                   wrapText="true" styleClass="card-body"/>
                            <Label text="Working Hours: Daily 8am - 11pm"
                                   wrapText="true" styleClass="card-body"/>

                            <HBox alignment="CENTER_RIGHT">
                                <Button text="Contact  ›" styleClass="contact-button"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                </VBox>
            </content>
        </ScrollPane>

    </VBox>
</AnchorPane>
