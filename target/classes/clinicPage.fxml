        </HBox>
        <Label prefHeight="34.0" prefWidth="204.0" styleClass="header-label" text="Clinics Nearby " wrapText="true" />

        <HBox alignment="CENTER" />

        <ScrollPane fitToWidth="true" styleClass="edge-to-edge-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="clinicListContainer" spacing="15.0">
                    <children>
                        <VBox prefHeight="143.0" prefWidth="282.0" spacing="8.0" styleClass="schedule-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label fx:id="appointmentDate" styleClass="card-date-header" text="Clinic 1" />
